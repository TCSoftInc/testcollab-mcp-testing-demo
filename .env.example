# Copy this file to .env and replace the three values.
TC_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT_ID
TESTCOLLAB_TOKEN=REPLACE_WITH_YOUR_API_TOKEN
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY

# Optional. Leave unset for TestCollab US SaaS.
# TC_API_URL=https://api-eu.testcollab.io

